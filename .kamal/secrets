# Secrets defined here are available for reference under registry/password, env/secret, builder/secrets,
# and accessories/*/env/secret in config/deploy.yml. All secrets should be pulled from either
# password manager, ENV, or a file. DO NOT ENTER RAW CREDENTIALS HERE! This file needs to be safe for git.

# GitHub Container Registry password.
#   CI   : the workflow passes the job's GITHUB_TOKEN.
#   Local: export KAMAL_REGISTRY_PASSWORD=$(gh auth token)
#          or a classic PAT with write:packages.
KAMAL_REGISTRY_PASSWORD=$KAMAL_REGISTRY_PASSWORD

# Basic-auth password for the review site.
#   Local: read from .env (git-ignored) when it exists.
#   CI   : .env does not exist, so the REVIEW_PASS env var set from the
#          repository secret of the same name is used.
# printenv is used instead of $REVIEW_PASS so Kamal does not interpolate the
# variable before the shell runs.
REVIEW_PASS=$(sh -c 'set -a; [ -f .env ] && . ./.env; printenv REVIEW_PASS')
