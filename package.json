{
  "name": "design-vs-live",
  "version": "0.1.0",
  "private": true,
  "description": "Compare the exported Claude design project with the live site: alignment, size, color, type, spacing and behavior",
  "scripts": {
    "start": "node tools/server.mjs --open",
    "serve": "node tools/server.mjs",
    "dev": "node --env-file-if-exists=.env --watch tools/server.mjs",
    "test": "node --test \"test/**/*.test.mjs\"",
    "dc": "node tools/dc.mjs",
    "browsers": "playwright install chromium",
    "pull-decisions": "node tools/pull-decisions.mjs",
    "compare": "node --env-file-if-exists=.env tools/compare.mjs"
  },
  "devDependencies": {
    "@anthropic-ai/sdk": "^1.10.0",
    "playwright": "^1.64.1"
  },
  "dependencies": {
    "express": "^5.3.0",
    "jpeg-js": "^0.4.4",
    "pngjs": "^7.0.0"
  },
  "engines": {
    "node": ">=22.9"
  }
}
