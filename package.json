{
  "name": "design-system-review",
  "version": "0.1.0",
  "private": true,
  "description": "Review tooling for turning the exported Claude design project into a design system",
  "scripts": {
    "start": "node tools/server.mjs --open",
    "serve": "node tools/server.mjs",
    "dev": "node --env-file-if-exists=.env --watch tools/server.mjs",
    "test": "node --test \"test/**/*.test.mjs\"",
    "dc": "node tools/dc.mjs",
    "survey": "node tools/survey.mjs",
    "components": "node tools/components.mjs",
    "browsers": "playwright install chromium",
    "pull-decisions": "node tools/pull-decisions.mjs"
  },
  "devDependencies": {
    "playwright": "^1.64.1"
  },
  "dependencies": {
    "express": "^5.3.0"
  },
  "engines": {
    "node": ">=22.9"
  }
}
